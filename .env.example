# Copy this file to .env and replace every change_me value before running docker compose.
# Each database password appears twice (the *_PASSWORD line and its *_URL line): keep both identical.

# Shared secrets
JWT_SECRET=change_me
INTERNAL_SECRET=change_me

# Gateway and front end
GATEWAY_PORT=3000
FRONTEND_PORT=3000

# Service URLs used by the gateway
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
POST_SERVICE_URL=http://post-service:3003
PROFIL_SERVICE_URL=http://profil-service:3004

# Auth service and its PostgreSQL database
AUTH_PORT=3001
AUTH_DB_USER=user
AUTH_DB_PASSWORD=change_me
AUTH_DB_NAME=auth_db
AUTH_DB_URL=postgres://user:change_me@pg-auth:5432/auth_db

# User service and its PostgreSQL database
USER_PORT=3002
USER_DB_USER=user
USER_DB_PASSWORD=change_me
USER_DB_NAME=users_db
USER_DB_URL=postgres://user:change_me@pg-users:5432/users_db

# MongoDB credentials, shared by the post and profil databases
MONGO_USER=admin
MONGO_PASSWORD=change_me

# Post service and its MongoDB database
POST_PORT=3003
POST_DB_URL=mongodb://admin:change_me@mongo-posts:27017/posts_db?authSource=admin
# Optional: OpenRouter API key for the @breezy_ai bot
OPENROUTER_API_KEY=

# Profil service and its MongoDB database
PROFIL_PORT=3004
PROFIL_DB_URL=mongodb://admin:change_me@mongo-profils:27017/profils_db?authSource=admin

# ═══════════════════════════════════════════════════════════════════════
# Breezy — Variables d'environnement (template)
# ═══════════════════════════════════════════════════════════════════════
# Copiez ce fichier en .env et remplacez toutes les valeurs CHANGE_ME
# par des secrets forts. Ne jamais commiter le vrai .env !
# ═══════════════════════════════════════════════════════════════════════

# Sécurité Globale — utilisez des secrets d'au moins 64 caractères aléatoires
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_CHARS_MINIMUM
INTERNAL_SECRET=CHANGE_ME_INTERNAL_SECRET_64_CHARS_MINIMUM

# Configuration Gateway & Front
GATEWAY_PORT=3000
FRONTEND_PORT=3000

# URLs d'aiguillage pour la Gateway
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
POST_SERVICE_URL=http://post-service:3003
PROFIL_SERVICE_URL=http://profil-service:3004

# Configuration Auth Service & sa DB
AUTH_PORT=3001
AUTH_DB_USER=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
AUTH_DB_NAME=auth_db
AUTH_DB_URL=postgres://CHANGE_ME:CHANGE_ME@pg-auth:5432/auth_db

# Configuration User Service & sa DB
USER_PORT=3002
USER_DB_USER=CHANGE_ME
USER_DB_PASSWORD=CHANGE_ME
USER_DB_NAME=users_db
USER_DB_URL=postgres://CHANGE_ME:CHANGE_ME@pg-users:5432/users_db

# MongoDB — credentials communs aux deux instances Mongo
# Ces valeurs doivent correspondre à MONGO_INITDB_ROOT_USERNAME/PASSWORD
# utilisés par les conteneurs mongo-posts et mongo-profils.
MONGO_USER=CHANGE_ME
MONGO_PASSWORD=CHANGE_ME

# Configuration Post Service & sa DB
POST_PORT=3003
POST_DB_URL=mongodb://CHANGE_ME:CHANGE_ME@mongo-posts:27017/posts_db?authSource=admin

# Configuration Profil Service & sa DB
PROFIL_PORT=3004
PROFIL_DB_URL=mongodb://CHANGE_ME:CHANGE_ME@mongo-profils:27017/profils_db?authSource=admin